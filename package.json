{
  "name": "nina-et-diego",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "sh scripts/vercel-build.sh",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:bench": "vitest run tests/bench --disable-console-intercept"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@parcel/watcher"
    ],
    "overrides": {
      "sharp": "^0.35.3",
      "postcss": "^8.5.26",
      "deepmerge-ts": "^8.0.0"
    }
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.3",
    "@react-email/components": "^1.0.12",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "clsx": "2.1.1",
    "next": "15.5.23",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.13.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.19.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "stripe": "^22.5.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "dotenv": "^17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.23",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
