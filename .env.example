# ---------------------------------------------------------------------------
# Base de données
# Dev   : PostgreSQL 16 local
# Prod  : Supabase (DIRECT_URL = connexion directe, sans pgbouncer, pour migrate)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nina_diego?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nina_diego?schema=public"

# ---------------------------------------------------------------------------
# Auth.js v5
# AUTH_SECRET : openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Temps réel
# REALTIME_PROVIDER=supabase | sse
#   supabase → Supabase Realtime (production)
#   sse      → SSE + LISTEN/NOTIFY Postgres (dev local, sans Supabase)
# ---------------------------------------------------------------------------
REALTIME_PROVIDER="sse"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Négociation — ÉTEINTE si absente
#
# La boutique ne propose pas d'offres pour l'instant. Toute la mécanique existe
# et reste testée ; « 1 » l'allume. Redéployez ensuite : les fiches en cache
# continueraient sinon de cacher le formulaire jusqu'à leur échéance.
# ---------------------------------------------------------------------------
OFFERS_ENABLED=""

# ---------------------------------------------------------------------------
# Paiement — Stripe
#
# LES TROIS VONT ENSEMBLE. Avec deux sur trois, le paiement reste éteint et le
# bouton « Commander » est désactivé — délibérément.
#
# Ce que coûtait l'ancien garde-fou, qui n'en vérifiait qu'une :
#  - clé secrète seule : la commande était créée et le stock verrouillé trente
#    minutes avant que le cadre de paiement n'annonce la panne ;
#  - sans le secret de rappel : la carte était débitée, l'appel signé refusé,
#    et la commande ne devenait JAMAIS payée.
# ---------------------------------------------------------------------------
# Ouvre la session de paiement, côté serveur.
STRIPE_SECRET_KEY=""
# Vérifie l'appel signé qui marque la commande payée.
STRIPE_WEBHOOK_SECRET=""
# Affiche le cadre de saisie de carte, côté navigateur.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------------------
# Expédition
# SHIPPING_PROVIDER=boxtal | mock
# ---------------------------------------------------------------------------
SHIPPING_PROVIDER="mock"
BOXTAL_API_KEY=""
BOXTAL_API_SECRET=""
BOXTAL_ENV="sandbox"

# ---------------------------------------------------------------------------
# Emails
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
# Sur un domaine VÉRIFIÉ chez Resend, par exemple
#   Nina & Diego <bonjour@mail.votre-domaine.fr>
# Une adresse resend.dev ou example.com n'écrit à personne : le panneau de mise
# en service le signale.
EMAIL_FROM=""

# ---------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Synchronisation avec l'application de gestion
#
# Contrat : docs/synchronisation.md. Les trois secrets se génèrent avec
#   openssl rand -base64 32
# et se posent dans les variables d'environnement des DEUX projets Vercel.
# Jamais dans le dépôt, jamais dans une conversation.
#
# SYNC_API_KEY absente : POST /api/sync/articles refuse TOUT. C'est voulu —
# une variable oubliée ne doit pas ouvrir l'écriture du catalogue.
# ---------------------------------------------------------------------------
SYNC_API_KEY=""
# Signature des appels sortants vers l'application (remontée des ventes).
SYNC_WEBHOOK_SECRET=""
SYNC_WEBHOOK_URL=""

# ---------------------------------------------------------------------------
# IA — pré-remplissage fiche article + traductions
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Notifications push (PWA)
# npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# Divers
# ---------------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Comptes de démonstration — DÉVELOPPEMENT UNIQUEMENT
# Sans cette variable, le seed ne crée aucun compte. Aucune valeur de repli :
# un mot de passe écrit dans le code finit publié avec lui.
# ---------------------------------------------------------------------------
SEED_ADMIN_PASSWORD=""
SENTRY_DSN=""

# ---------------------------------------------------------------------------
# Identité légale d'une SOCIÉTÉ (mentions légales, CGV, factures)
#
# Les neuf premières vont ensemble : tant qu'une manque, les CGV ne sont pas
# publiées, aucune acceptation n'est horodatée et aucune facture n'est émise.
# Le panneau de mise en service nomme celles qui manquent.
# LCEN art. 1-1 ; code de commerce art. R123-237.
# ---------------------------------------------------------------------------
LEGAL_COMPANY_NAME=""
# « SAS », « SASU »… comme sur le Kbis.
LEGAL_FORM=""
# Écrit tel qu'il s'affiche : « 1 000 € ».
LEGAL_CAPITAL=""
# Les 14 chiffres. Le SIREN en est déduit.
LEGAL_SIRET=""
# Ville du greffe d'immatriculation.
LEGAL_RCS_CITY=""
# Adresse du siège social.
LEGAL_ADDRESS=""
# Reçoit aussi les avis de commande et de rétractation.
LEGAL_EMAIL=""
LEGAL_PHONE=""
# Pour une société, son représentant légal : le président d'une SAS
# (loi n° 82-652, art. 93-2).
LEGAL_PUBLICATION_DIRECTOR=""
# Facultatif : seulement si la société a un numéro de TVA intracommunautaire.
LEGAL_VAT_NUMBER=""

# Médiateur de la consommation : nom, adresse postale ET site, exigés tous les
# trois (L612-1 du code de la consommation).
LEGAL_MEDIATOR_NAME=""
LEGAL_MEDIATOR_ADDRESS=""
LEGAL_MEDIATOR_URL=""
